# ─────────────────────────────────────────────────────────────
# Backend (FastAPI + PostgreSQL)
# ─────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/email_agent
MOCK_EMAIL_FILE=/app/mock_data/emails.json
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─────────────────────────────────────────────────────────────
# Frontend — Docker Compose (recommended)
# ─────────────────────────────────────────────────────────────
RENDER_BACKEND_URL=http://backend:8000
NEXT_PUBLIC_BACKEND_URL=

# ─────────────────────────────────────────────────────────────
# Frontend — Local dev (npm run dev, no Docker)
# Leave both empty to use same-origin Next.js /api/* mock engine
# ─────────────────────────────────────────────────────────────
# RENDER_BACKEND_URL=
# NEXT_PUBLIC_BACKEND_URL=

# ─────────────────────────────────────────────────────────────
# Frontend — Vercel live demo (set in Vercel dashboard)
# ─────────────────────────────────────────────────────────────
# RENDER_BACKEND_URL=https://ai-email-reading-agent.onrender.com
# NEXT_PUBLIC_BACKEND_URL=
